  "components": {
    "schemas": {
      "CreateVehicleDTO": {
        "type": "object",
        "properties": {
          "make": {
            "type": "string",
            "maxLength": 31,
            "minLength": 0
          },
          "model": {
            "type": "string",
            "maxLength": 31,
            "minLength": 0
          },
          "vehicleType": {
            "$ref": "#/components/schemas/VehicleTypeDTO"
          },
          "year": {
            "type": "integer",
            "format": "int32"
          },
          "vin": {
            "type": "string",
            "maxLength": 50,
            "minLength": 0
          },
          "registerNumber": {
            "type": "string",
            "maxLength": 15,
            "minLength": 0
          },
          "broken": {
            "type": "boolean"
          }
        },
        "required": [
          "broken",
          "make",
          "model",
          "vehicleType",
          "year"
        ]
      },
      "VehicleTypeDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
