  "paths": {
    "/vehicles": {
      "get": {
        "tags": [ "vehicle-controller" ],
        "summary": "Get a list of vehicles",
        "description": "Returns a list of all vehicles available in the system. Supports pagination.",
        "operationId": "getAllVehicles",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (zero-based index)",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "description": "Number of items per page",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 15
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Vehicle list retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/VehicleDTO"
                  }
                },
                "examples": {
                  "exampleResponse": {
                    "summary": "Example response",
                    "value": [
                      {
                        "id": "b2cf3ef1-0f7a-437a-b712-6bc2c9baf6e2",
                        "make": "Mercedes",
                        "model": "Actros",
                        "vehicleType": {
                          "id": "2c45a2dc-50cf-4bb9-bd49-ef37943b3402",
                          "name": "Truck"
                        },
                        "year": 2020,
                        "vin": "WDB96340310123456",
                        "registerNumber": "KR1C123",
                        "broken": false
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [ "vehicle-controller" ],
        "summary": "Add a new vehicle",
        "description": "Creates a new vehicle based on the submitted data.",
        "operationId": "createVehicle",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateVehicleDTO"
              },
              "examples": {
                "exampleRequest": {
                  "summary": "Example new vehicle data",
                  "value": {
                    "make": "MAN",
                    "model": "TGX",
                    "vehicleType": {
                      "id": "00000000-0000-0000-0000-000000000004"
                    },
                    "year": 2021,
                    "vin": "WMA06XZZ9HP123456",
                    "registerNumber": "PO2B456",
                    "broken": false
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Vehicle created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VehicleDTO"
                }
              }
            }
          }
        }
      }
    },
